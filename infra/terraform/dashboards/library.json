  {
   "type": "stat",
   "title": "Disponibilité (30 j) — SLO 99,5 %",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "1 - sum(increase(http_request_duration_seconds_count{namespace=\"$namespace\",route!=\"unmatched\",status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_request_duration_seconds_count{namespace=\"$namespace\",route!=\"unmatched\"}[30d])), 1)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "SLI disponibilité : part des requêtes API non-5xx"
  },
